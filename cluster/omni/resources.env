# Slurm resources and hardware knobs used by EVERY GPU job of this project.
# Filled in RUNBOOK_OMNI.md step 3 (resources) and step 5 (knobs), then committed.
# Every sbatch command is run after:  source cluster/omni/resources.env
#
# RESOURCE_FLAGS: sbatch flags for ONE full (non-MIG) GPU with >= 80 GB memory,
# as much host RAM as the partition allows (target >= 256G), >= 32 CPUs if
# allowed, and the partition's maximum time limit. Example shape only, not
# Omni's real values:
#   RESOURCE_FLAGS="-p <partition> --gres=<full-GPU gres> --cpus-per-task=32 --mem=256G --time=<max>"
export RESOURCE_FLAGS=""
export TIME_LIMIT_HOURS=""        # the --time value in hours, used to size job chains

# Hardware knobs (RUNBOOK_OMNI.md, "Fitting a run"). Defaults shown; change only
# by the ladder, then keep identical for every condition and seed.
export N_GPUS=1
export MICRO_BS=16
export GPU_MEM_UTIL=0.5
export VAL_BATCH=128
export REF_OFFLOAD=True
